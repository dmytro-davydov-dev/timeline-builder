# Server
PORT=3000

# Database (SQLite file path for MVP; swap to a Postgres URL later with no code change
# beyond the TypeORM connection options in apps/api/src/database/database.module.ts)
DATABASE_PATH=./data/medical-timeline.sqlite

# LLM provider for AI Chat tool-calling (set one)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend (apps/web) — Vite env vars must be prefixed VITE_
VITE_API_BASE_URL=http://localhost:3000
