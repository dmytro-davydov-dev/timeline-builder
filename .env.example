# Server
PORT=3000

# Database — local dev uses sql.js/SQLite (DATABASE_PATH) by default, zero setup.
# Set DATABASE_URL to a postgres:// connection string (Vercel Postgres, Neon,
# Supabase, Render, etc.) to switch to Postgres instead — required for any
# stateless/serverless deployment (e.g. Vercel), since sql.js's on-disk file
# doesn't survive across separate function invocations there. See
# apps/api/src/database/database.module.ts for details.
DATABASE_PATH=./data/medical-timeline.sqlite
DATABASE_URL=

# Default case auto-seeded on first boot if the `cases` table is empty (see
# apps/api/src/excel-import/default-case-seeder.service.ts) so the app has
# something to show at "/" without requiring an upload first. Path is
# resolved relative to apps/api's working directory; override to point at a
# different demo Excel.
DEFAULT_CASE_EXCEL_PATH=./assets/Caldwell - Medical Chronology.xlsx

# LLM provider for AI Chat tool-calling (set one)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend (apps/web) — Vite env vars must be prefixed VITE_
VITE_API_BASE_URL=http://localhost:3000
